{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "af-david-page",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "david.afinancialpartner.com", "custom_domain": true }
  ]
}
